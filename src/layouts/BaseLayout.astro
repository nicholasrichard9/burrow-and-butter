---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SEOHead from '@/components/SEOHead.astro';
import NewsletterPopup from '@/components/NewsletterPopup.astro';
import { siteConfig } from '@/data/site.config';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  author?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  image = siteConfig.defaultOgImage,
  imageAlt = siteConfig.name,
  canonicalUrl,
  type = 'website',
  publishedDate,
  updatedDate,
  author,
  noIndex = false,
} = Astro.props;

const fullTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <SEOHead
      title={fullTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonicalUrl={canonicalUrl}
      type={type}
      publishedDate={publishedDate}
      updatedDate={updatedDate}
      author={author}
      noIndex={noIndex}
    />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Pagefind search (loaded on demand) -->
    {siteConfig.features.search && (
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    )}

    <!-- Google Analytics -->
    {siteConfig.analytics.googleAnalyticsId && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.analytics.googleAnalyticsId}`}
        />
        <script define:vars={{ gaId: siteConfig.analytics.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- Skip link for accessibility -->
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>

    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Newsletter popup (exit intent / scroll) -->
    {(siteConfig.features.exitIntent || siteConfig.features.scrollPrompt) && (
      <NewsletterPopup />
    )}

    <!-- Pagefind script -->
    {siteConfig.features.search && (
      <script>
        window.addEventListener('DOMContentLoaded', () => {
          const searchTrigger = document.getElementById('search-trigger');
          const searchModal = document.getElementById('search-modal');

          if (searchTrigger && searchModal) {
            searchTrigger.addEventListener('click', async () => {
              // Lazy load Pagefind
              if (!window.PagefindUI) {
                const script = document.createElement('script');
                script.src = '/pagefind/pagefind-ui.js';
                document.head.appendChild(script);
                await new Promise(resolve => script.onload = resolve);
              }
              searchModal.classList.remove('hidden');
              // Initialize Pagefind UI if not done
              const container = document.getElementById('pagefind-container');
              if (container && !container.hasChildNodes()) {
                new PagefindUI({ element: container, showImages: true });
              }
            });
          }
        });
      </script>
    )}

    <slot name="scripts" />
  </body>
</html>
