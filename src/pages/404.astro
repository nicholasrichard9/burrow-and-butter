---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  noIndex={true}
>
  <section class="py-24">
    <div class="container-narrow text-center">
      <!-- 404 illustration -->
      <div class="mb-8">
        <span class="font-display text-[8rem] md:text-[12rem] text-cream-300 leading-none">404</span>
      </div>

      <h1 class="text-bark-900 mb-4">Page not found</h1>
      <p class="text-lg text-bark-600 mb-8 max-w-md mx-auto">
        Looks like this recipe got lost in the kitchen. Let's get you back on track.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">
          Go Home
        </a>
        <a href="/recipes" class="btn-outline">
          Browse Recipes
        </a>
      </div>

      <!-- Search suggestion -->
      <div class="mt-12 text-bark-500">
        <p>Or try searching for what you're looking for:</p>
        <button
          type="button"
          class="mt-4 px-6 py-3 border-2 border-cream-300 rounded-lg text-bark-600 hover:border-moss-500 hover:text-moss-600 transition-colors"
          onclick="document.getElementById('search-trigger')?.click()"
        >
          <span class="flex items-center gap-2 justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Search
          </span>
        </button>
      </div>
    </div>
  </section>
</BaseLayout>
