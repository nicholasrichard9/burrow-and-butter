---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
---

<BaseLayout
  title="Shop"
  description="Digital products from Burrow and Butter—cookbooks, guides, and more."
>
  <article class="py-12">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-cream-100 to-cream-50 py-12 md:py-16">
      <div class="container-narrow text-center">
        <h1 class="text-bark-900 mb-4">Shop</h1>
        <p class="text-xl text-bark-600">
          Digital cookbooks, guides, and more from our kitchen to yours.
        </p>
      </div>
    </section>

    <!-- Coming Soon -->
    <section class="py-16">
      <div class="container-narrow text-center">
        <div class="bg-cream-100 rounded-xl p-12">
          <div class="w-20 h-20 bg-moss-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-moss-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h2 class="font-display text-display-lg text-bark-900 mb-4">Coming Soon</h2>
          <p class="text-bark-600 max-w-md mx-auto mb-8">
            We're working on our first digital cookbook and some other goodies.
            Sign up below to be the first to know when they're ready.
          </p>
          <div class="max-w-md mx-auto">
            <NewsletterForm source="shop" />
          </div>
        </div>
      </div>
    </section>

    <!-- What to expect -->
    <section class="py-12">
      <div class="container-narrow">
        <h2 class="font-display text-display-md text-bark-900 text-center mb-8">What's Coming</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl p-6 shadow-cozy">
            <h3 class="font-display text-display-sm text-bark-900 mb-2">Digital Cookbooks</h3>
            <p class="text-bark-600">
              Our best recipes, organized by theme, with exclusive content you won't find on the blog.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-cozy">
            <h3 class="font-display text-display-sm text-bark-900 mb-2">Technique Guides</h3>
            <p class="text-bark-600">
              Deep dives into specific cooking techniques, with step-by-step instructions and troubleshooting tips.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-cozy">
            <h3 class="font-display text-display-sm text-bark-900 mb-2">Meal Prep Plans</h3>
            <p class="text-bark-600">
              Weekly meal plans with shopping lists, prep guides, and recipes that work together.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-cozy">
            <h3 class="font-display text-display-sm text-bark-900 mb-2">Kitchen Essentials</h3>
            <p class="text-bark-600">
              Our curated lists of recommended equipment and ingredients, tested in both our kitchens.
            </p>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
