---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/site.config';
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Burrow and Butter team."
>
  <article class="py-12">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-cream-100 to-cream-50 py-12 md:py-16">
      <div class="container-narrow text-center">
        <h1 class="text-bark-900 mb-4">Contact Us</h1>
        <p class="text-xl text-bark-600">
          We'd love to hear from you.
        </p>
      </div>
    </section>

    <!-- Contact Options -->
    <section class="py-12">
      <div class="container-narrow">
        <div class="grid md:grid-cols-2 gap-8 max-w-2xl mx-auto">
          <!-- General Inquiries -->
          <div class="bg-white rounded-xl p-8 shadow-cozy text-center">
            <div class="w-12 h-12 bg-moss-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-moss-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <h2 class="font-display text-display-sm text-bark-900 mb-2">General Questions</h2>
            <p class="text-bark-600 mb-4">
              Recipe questions, feedback, or just want to say hi?
            </p>
            <a href={`mailto:${siteConfig.social.email}`} class="text-moss-600 hover:text-moss-700 font-medium">
              {siteConfig.social.email}
            </a>
          </div>

          <!-- Partnerships -->
          <div class="bg-white rounded-xl p-8 shadow-cozy text-center">
            <div class="w-12 h-12 bg-copper-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-copper-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
              </svg>
            </div>
            <h2 class="font-display text-display-sm text-bark-900 mb-2">Partnerships</h2>
            <p class="text-bark-600 mb-4">
              Interested in working together?
            </p>
            <a href="/work-with-us" class="text-copper-600 hover:text-copper-700 font-medium">
              View partnership info →
            </a>
          </div>
        </div>

        <!-- Social -->
        <div class="mt-12 text-center">
          <h2 class="font-display text-display-sm text-bark-900 mb-4">Follow Along</h2>
          <div class="flex justify-center gap-6">
            <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="text-bark-500 hover:text-copper-600 transition-colors">
              <span class="sr-only">Instagram</span>
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a href={siteConfig.social.pinterest} target="_blank" rel="noopener noreferrer" class="text-bark-500 hover:text-copper-600 transition-colors">
              <span class="sr-only">Pinterest</span>
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
              </svg>
            </a>
            <a href={siteConfig.social.tiktok} target="_blank" rel="noopener noreferrer" class="text-bark-500 hover:text-copper-600 transition-colors">
              <span class="sr-only">TikTok</span>
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
              </svg>
            </a>
            <a href={siteConfig.social.youtube} target="_blank" rel="noopener noreferrer" class="text-bark-500 hover:text-copper-600 transition-colors">
              <span class="sr-only">YouTube</span>
              <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
