---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { siteConfig } from '@/data/site.config';
---

<BaseLayout
  title="Newsletter"
  description="Get tested recipes, restaurant reviews, and kitchen wisdom from a chef and home cook—delivered weekly."
>
  <article class="py-12">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-moss-700 to-moss-800 py-16 md:py-24">
      <div class="container-narrow text-center">
        <h1 class="text-white mb-6">Join Our Kitchen Table</h1>
        <p class="text-xl text-moss-100 mb-8">
          Every week, we send you tested recipes, local restaurant picks,
          and the occasional debate about whether mise en place is overrated.
        </p>

        <!-- Main signup form -->
        <div class="max-w-md mx-auto">
          <NewsletterForm theme="dark" showLeadMagnet={true} source="newsletter-page" />
        </div>
      </div>
    </section>

    <!-- What you get -->
    <section class="py-16">
      <div class="container-narrow">
        <h2 class="text-bark-900 text-center mb-12">What You'll Get</h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 bg-moss-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-moss-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="font-display text-display-sm text-bark-900 mb-2">Weekly Recipes</h3>
            <p class="text-bark-600">
              One tested recipe every week, with testing notes, chef tips, and honest assessments of what's worth the effort.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-copper-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-copper-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <h3 class="font-display text-display-sm text-bark-900 mb-2">Local Picks</h3>
            <p class="text-bark-600">
              Restaurant recommendations from Chicago and Houston, plus travel food finds when we're on the road.
            </p>
          </div>

          <div class="text-center">
            <div class="w-16 h-16 bg-bark-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-bark-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="font-display text-display-sm text-bark-900 mb-2">Kitchen Wisdom</h3>
            <p class="text-bark-600">
              Tips, techniques, and the occasional friendly argument between our chef and home cook.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Lead magnet highlight -->
    {siteConfig.newsletter.leadMagnet.enabled && (
      <section class="py-12 bg-cream-100">
        <div class="container-narrow text-center">
          <span class="badge-copper mb-4">Free Download</span>
          <h2 class="text-bark-900 mb-4">{siteConfig.newsletter.leadMagnet.title}</h2>
          <p class="text-bark-600 mb-6 max-w-lg mx-auto">
            {siteConfig.newsletter.leadMagnet.description}
          </p>
          <p class="text-bark-500 text-sm">
            Sign up above and we'll send it to your inbox immediately.
          </p>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="py-12">
      <div class="container-narrow">
        <h2 class="text-bark-900 text-center mb-8">Questions</h2>

        <div class="space-y-6 max-w-2xl mx-auto">
          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer py-4 border-b border-cream-200">
              <span class="font-sans font-medium text-bark-800">How often will I hear from you?</span>
              <span class="text-moss-600 group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="py-4 text-bark-600">
              Once a week, on Saturdays. We don't believe in cluttering your inbox.
              Occasionally we'll send an extra email for something special, but never more than twice a week.
            </p>
          </details>

          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer py-4 border-b border-cream-200">
              <span class="font-sans font-medium text-bark-800">Can I unsubscribe?</span>
              <span class="text-moss-600 group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="py-4 text-bark-600">
              Absolutely. Every email has an unsubscribe link at the bottom. One click and you're out—no guilt, no hard feelings.
            </p>
          </details>

          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer py-4 border-b border-cream-200">
              <span class="font-sans font-medium text-bark-800">Will you sell my email?</span>
              <span class="text-moss-600 group-open:rotate-180 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="py-4 text-bark-600">
              Never. Your email stays with us. We use it to send you our newsletter and nothing else.
              See our <a href="/privacy" class="text-moss-600 hover:text-moss-700 underline">privacy policy</a> for details.
            </p>
          </details>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
