---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuthorCard from '@/components/AuthorCard.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { siteConfig, authors } from '@/data/site.config';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

interface Props {
  essay: CollectionEntry<'essays'>;
}

const { essay } = Astro.props;
const { data, slug } = essay;
const { Content } = await essay.render();

const author = authors[data.author];
const canonicalUrl = `${siteConfig.url}/essays/${slug}`;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.heroImage.src}
  imageAlt={data.heroImageAlt}
  canonicalUrl={canonicalUrl}
  type="article"
  publishedDate={data.publishedDate}
  updatedDate={data.updatedDate}
  author={author.name}
>
  <article class="py-8 md:py-12" data-pagefind-body>
    <div class="container-narrow">
      <!-- Breadcrumb -->
      <nav class="text-sm font-sans mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-bark-500">
          <li><a href="/" class="hover:text-moss-600">Home</a></li>
          <li>/</li>
          <li><a href="/essays" class="hover:text-moss-600">Essays</a></li>
          <li>/</li>
          <li class="text-bark-700 truncate">{data.title}</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8 text-center">
        {data.category && (
          <span class="badge-moss mb-4">{data.category}</span>
        )}
        <h1 class="text-bark-900 mb-4">{data.title}</h1>
        <p class="text-lg text-bark-600 max-w-2xl mx-auto">{data.description}</p>

        <!-- Author & Date -->
        <div class="flex items-center justify-center gap-4 mt-6 text-bark-500">
          <a href={`/authors/${data.author}`} class="flex items-center gap-2 hover:text-copper-600">
            <img
              src={author.avatar}
              alt={author.name}
              class="w-8 h-8 rounded-full"
            />
            <span class="font-medium">{author.name}</span>
          </a>
          <span>•</span>
          <time datetime={data.publishedDate.toISOString()}>
            {data.publishedDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
        </div>
      </header>

      <!-- Hero Image -->
      <figure class="mb-8 -mx-4 sm:mx-0">
        <Image
          src={data.heroImage}
          alt={data.heroImageAlt}
          width={800}
          height={500}
          class="w-full rounded-none sm:rounded-xl"
          loading="eager"
        />
      </figure>

      <!-- Content -->
      <div class="prose prose-lg max-w-none mb-12">
        <Content />
      </div>

      <!-- Newsletter CTA -->
      <div class="bg-cream-100 rounded-xl p-8 text-center mb-12">
        <h2 class="font-display text-display-md text-bark-900 mb-4">
          Enjoyed this?
        </h2>
        <p class="text-bark-600 mb-6 max-w-md mx-auto">
          Get essays like this, plus recipes and restaurant picks, delivered weekly.
        </p>
        <NewsletterForm source="essay" />
      </div>

      <!-- Author bio -->
      <AuthorCard authorId={data.author} variant="full" />

      <!-- Dates -->
      <footer class="mt-8 pt-6 border-t border-cream-200 text-sm text-bark-500 font-sans">
        <p>Published: {data.publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        {data.updatedDate && (
          <p>Updated: {data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        )}
      </footer>
    </div>
  </article>
</BaseLayout>
