---
interface Props {
  variant?: 'button' | 'floating';
}

const { variant = 'button' } = Astro.props;
---

{variant === 'button' ? (
  <a
    href="#recipe-card"
    class="inline-flex items-center gap-2 px-4 py-2 bg-moss-600 text-white rounded-lg hover:bg-moss-700 transition-colors font-sans text-sm font-medium no-print"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
    Jump to Recipe
  </a>
) : (
  <a
    href="#recipe-card"
    class="fixed bottom-4 right-4 z-30 flex items-center gap-2 px-4 py-3 bg-moss-600 text-white rounded-full shadow-lg hover:bg-moss-700 transition-all font-sans text-sm font-medium no-print md:hidden"
    aria-label="Jump to recipe"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
    <span>Recipe</span>
  </a>
)}
