---
import { siteConfig } from '@/data/site.config';
import NewsletterForm from './NewsletterForm.astro';

const currentYear = new Date().getFullYear();

const footerLinks = {
  explore: [
    { href: '/recipes', label: 'Recipes' },
    { href: '/reviews', label: 'Restaurant Reviews' },
    { href: '/features', label: 'Chef vs. Home Cook' },
    { href: '/essays', label: 'Essays' },
  ],
  about: [
    { href: '/about', label: 'About Us' },
    { href: '/authors/nick', label: 'Meet Nick' },
    { href: '/authors/xavier', label: 'Meet Xavier' },
    { href: '/contact', label: 'Contact' },
  ],
  more: [
    { href: '/work-with-us', label: 'Work With Us' },
    { href: '/shop', label: 'Shop' },
    { href: '/privacy', label: 'Privacy Policy' },
    { href: '/disclosure', label: 'Disclosure' },
  ],
};

const socialLinks = [
  {
    name: 'Instagram',
    href: siteConfig.social.instagram,
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  },
  {
    name: 'Pinterest',
    href: siteConfig.social.pinterest,
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>`,
  },
  {
    name: 'TikTok',
    href: siteConfig.social.tiktok,
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>`,
  },
  {
    name: 'YouTube',
    href: siteConfig.social.youtube,
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
];
---

<footer class="bg-bark-800 text-cream-100 mt-auto">
  <!-- Newsletter Section -->
  <div class="bg-moss-700">
    <div class="container-wide py-12">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="font-display text-display-lg text-white mb-3">
          Join our kitchen table
        </h2>
        <p class="text-moss-100 mb-6">
          Get tested recipes, local restaurant finds, and behind-the-scenes kitchen stories delivered weekly.
        </p>
        <NewsletterForm theme="dark" />
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="container-wide py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="font-display text-display-md text-cream-100 hover:text-white transition-colors">
          {siteConfig.name}
        </a>
        <p class="mt-3 text-sm text-bark-300">
          {siteConfig.tagline}
        </p>
        <!-- Social Links -->
        <div class="flex gap-4 mt-6">
          {socialLinks.map(social => (
            <a
              href={social.href}
              class="text-bark-400 hover:text-white transition-colors"
              aria-label={social.name}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="font-sans font-semibold text-white mb-4">Explore</h3>
        <ul class="space-y-2">
          {footerLinks.explore.map(link => (
            <li>
              <a href={link.href} class="text-bark-300 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- About -->
      <div>
        <h3 class="font-sans font-semibold text-white mb-4">About</h3>
        <ul class="space-y-2">
          {footerLinks.about.map(link => (
            <li>
              <a href={link.href} class="text-bark-300 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- More -->
      <div>
        <h3 class="font-sans font-semibold text-white mb-4">More</h3>
        <ul class="space-y-2">
          {footerLinks.more.map(link => (
            <li>
              <a href={link.href} class="text-bark-300 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-bark-700 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-bark-400">
      <p>
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <p>
        Made with love in Chicago & Houston
      </p>
    </div>
  </div>
</footer>
