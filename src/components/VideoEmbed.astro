---
interface Props {
  url: string;
  type: 'youtube' | 'tiktok' | 'instagram';
  title?: string;
}

const { url, type, title = 'Video' } = Astro.props;

// Extract video IDs
function getYouTubeId(url: string): string | null {
  const match = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([^&\s]+)/);
  return match?.[1] || null;
}

function getTikTokId(url: string): string | null {
  const match = url.match(/tiktok\.com\/@[\w.-]+\/video\/(\d+)/);
  return match?.[1] || null;
}

function getInstagramId(url: string): string | null {
  const match = url.match(/instagram\.com\/(?:p|reel)\/([^/?]+)/);
  return match?.[1] || null;
}

const youtubeId = type === 'youtube' ? getYouTubeId(url) : null;
const tiktokId = type === 'tiktok' ? getTikTokId(url) : null;
const instagramId = type === 'instagram' ? getInstagramId(url) : null;

const thumbnailUrl = youtubeId
  ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`
  : null;
---

<div class="video-embed my-8" data-video-type={type} data-video-url={url}>
  {type === 'youtube' && youtubeId && (
    <div class="relative aspect-video bg-bark-200 rounded-xl overflow-hidden group cursor-pointer" data-youtube-id={youtubeId}>
      <!-- Thumbnail (lazy loaded) -->
      {thumbnailUrl && (
        <img
          src={thumbnailUrl}
          alt={title}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      )}
      <!-- Play button overlay -->
      <button
        type="button"
        class="absolute inset-0 flex items-center justify-center bg-bark-900/20 group-hover:bg-bark-900/30 transition-colors"
        aria-label={`Play video: ${title}`}
        data-play-video
      >
        <span class="w-16 h-16 md:w-20 md:h-20 bg-red-600 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 md:w-10 md:h-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </button>
    </div>
  )}

  {type === 'tiktok' && tiktokId && (
    <div class="flex justify-center">
      <div
        class="bg-bark-200 rounded-xl p-4 text-center cursor-pointer hover:bg-bark-300 transition-colors max-w-sm"
        data-tiktok-id={tiktokId}
        data-play-video
      >
        <svg class="w-12 h-12 mx-auto mb-2 text-bark-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
        </svg>
        <p class="text-bark-700 font-sans text-sm">Click to load TikTok video</p>
      </div>
    </div>
  )}

  {type === 'instagram' && instagramId && (
    <div class="flex justify-center">
      <div
        class="bg-bark-200 rounded-xl p-4 text-center cursor-pointer hover:bg-bark-300 transition-colors max-w-sm"
        data-instagram-id={instagramId}
        data-play-video
      >
        <svg class="w-12 h-12 mx-auto mb-2 text-bark-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
        </svg>
        <p class="text-bark-700 font-sans text-sm">Click to load Instagram post</p>
      </div>
    </div>
  )}
</div>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const playButton = target.closest('[data-play-video]');

    if (!playButton) return;

    const container = playButton.closest('.video-embed') as HTMLElement;
    if (!container) return;

    const type = container.dataset.videoType;
    const wrapper = playButton.parentElement || playButton;

    if (type === 'youtube') {
      const youtubeId = (playButton.closest('[data-youtube-id]') as HTMLElement)?.dataset.youtubeId;
      if (youtubeId) {
        wrapper.innerHTML = `
          <iframe
            src="https://www.youtube.com/embed/${youtubeId}?autoplay=1&rel=0"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="w-full aspect-video rounded-xl"
          ></iframe>
        `;
      }
    }

    if (type === 'tiktok') {
      const tiktokId = (playButton.closest('[data-tiktok-id]') as HTMLElement)?.dataset.tiktokId;
      if (tiktokId) {
        wrapper.outerHTML = `
          <blockquote class="tiktok-embed" cite="https://www.tiktok.com/video/${tiktokId}" data-video-id="${tiktokId}">
            <section></section>
          </blockquote>
          <script async src="https://www.tiktok.com/embed.js"><\/script>
        `;
      }
    }

    if (type === 'instagram') {
      const instagramId = (playButton.closest('[data-instagram-id]') as HTMLElement)?.dataset.instagramId;
      if (instagramId) {
        wrapper.outerHTML = `
          <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/p/${instagramId}/" data-instgrm-version="14">
          </blockquote>
          <script async src="//www.instagram.com/embed.js"><\/script>
        `;
        // @ts-ignore
        if (window.instgrm) window.instgrm.Embeds.process();
      }
    }
  });
</script>
