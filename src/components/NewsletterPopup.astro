---
import { siteConfig } from '@/data/site.config';
import NewsletterForm from './NewsletterForm.astro';
---

<!-- Newsletter Popup (Exit Intent / Scroll) -->
<div
  id="newsletter-popup"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="popup-title"
>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-bark-900/60 backdrop-blur-sm" data-popup-close></div>

  <!-- Modal -->
  <div class="absolute inset-4 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:max-w-md w-full">
    <div class="bg-cream-50 rounded-2xl shadow-cozy-lg overflow-hidden h-full md:h-auto flex flex-col">
      <!-- Close button -->
      <button
        type="button"
        class="absolute top-4 right-4 p-2 text-bark-500 hover:text-bark-700 transition-colors z-10"
        aria-label="Close popup"
        data-popup-close
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Content -->
      <div class="p-6 md:p-8 flex-1 flex flex-col justify-center">
        <!-- Decorative element -->
        <div class="w-16 h-16 mx-auto mb-6 bg-moss-100 rounded-full flex items-center justify-center">
          <svg class="w-8 h-8 text-moss-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>

        <h2 id="popup-title" class="font-display text-display-lg text-center text-bark-900 mb-3">
          Wait, don't go hungry!
        </h2>

        <p class="text-center text-bark-600 mb-6">
          {siteConfig.newsletter.leadMagnet.enabled
            ? `Get our free guide: "${siteConfig.newsletter.leadMagnet.title}" plus weekly recipes and reviews.`
            : 'Join our newsletter for weekly recipes, restaurant finds, and kitchen wisdom from a chef and home cook.'
          }
        </p>

        <NewsletterForm
          theme="light"
          showLeadMagnet={false}
          source="popup"
        />
      </div>

      <!-- Bottom accent -->
      <div class="h-2 bg-gradient-to-r from-moss-500 via-copper-400 to-moss-500"></div>
    </div>
  </div>
</div>

<script define:vars={{ exitIntent: siteConfig.features.exitIntent, scrollPrompt: siteConfig.features.scrollPrompt }}>
  const popup = document.getElementById('newsletter-popup');
  const STORAGE_KEY = 'newsletter_popup_dismissed';
  const DISMISS_DURATION = 7 * 24 * 60 * 60 * 1000; // 7 days

  function isDismissed() {
    const dismissed = localStorage.getItem(STORAGE_KEY);
    if (!dismissed) return false;
    const dismissedTime = parseInt(dismissed, 10);
    return Date.now() - dismissedTime < DISMISS_DURATION;
  }

  function showPopup() {
    if (isDismissed() || !popup) return;
    popup.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function hidePopup() {
    if (!popup) return;
    popup.classList.add('hidden');
    document.body.style.overflow = '';
    localStorage.setItem(STORAGE_KEY, Date.now().toString());
  }

  // Close handlers
  document.querySelectorAll('[data-popup-close]').forEach(el => {
    el.addEventListener('click', hidePopup);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hidePopup();
  });

  // Exit intent (desktop only)
  if (exitIntent && window.matchMedia('(min-width: 768px)').matches) {
    let triggered = false;
    document.addEventListener('mouseout', (e) => {
      if (triggered || isDismissed()) return;
      if (e.clientY <= 0 || e.relatedTarget === null) {
        triggered = true;
        setTimeout(showPopup, 100);
      }
    });
  }

  // Scroll prompt (mobile fallback)
  if (scrollPrompt) {
    let triggered = false;
    const scrollThreshold = 0.5; // 50% of page

    window.addEventListener('scroll', () => {
      if (triggered || isDismissed()) return;
      const scrollPercent = window.scrollY / (document.body.scrollHeight - window.innerHeight);
      if (scrollPercent >= scrollThreshold) {
        triggered = true;
        setTimeout(showPopup, 2000); // Delay to not interrupt
      }
    }, { passive: true });
  }
</script>
