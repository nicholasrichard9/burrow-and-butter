---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  feature: CollectionEntry<'features'>;
}

const { feature } = Astro.props;
const { data, slug } = feature;
---

<article class="card-elevated group overflow-hidden">
  <a href={`/features/${slug}`} class="block">
    <!-- Hero image -->
    <div class="relative aspect-[16/9] overflow-hidden">
      <Image
        src={data.heroImage}
        alt={data.heroImageAlt}
        width={800}
        height={450}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
      <!-- Overlay badge -->
      <div class="absolute top-4 left-4 bg-copper-500 text-white px-3 py-1 rounded-full font-sans font-medium text-sm">
        Chef vs. Home Cook
      </div>
    </div>

    <!-- Content -->
    <div class="p-6">
      <h3 class="font-display text-display-md text-bark-900 group-hover:text-copper-600 transition-colors mb-3">
        {data.title}
      </h3>

      <p class="text-bark-600 mb-4 line-clamp-2">
        {data.description}
      </p>

      <!-- Side-by-side preview -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="text-center">
          <div class="aspect-square rounded-lg overflow-hidden mb-2">
            <Image
              src={data.chefVersion.image}
              alt={data.chefVersion.imageAlt}
              width={200}
              height={200}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <span class="text-sm font-sans font-medium text-moss-700">Chef's Way</span>
        </div>
        <div class="text-center">
          <div class="aspect-square rounded-lg overflow-hidden mb-2">
            <Image
              src={data.homeVersion.image}
              alt={data.homeVersion.imageAlt}
              width={200}
              height={200}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <span class="text-sm font-sans font-medium text-copper-700">Home Cook's Way</span>
        </div>
      </div>

      <!-- Verdict preview -->
      <p class="text-sm text-bark-500 italic">
        "{data.verdict.slice(0, 100)}{data.verdict.length > 100 ? '...' : ''}"
      </p>
    </div>
  </a>
</article>
