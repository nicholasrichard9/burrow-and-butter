{
  "$ref": "#/definitions/reviews",
  "definitions": {
    "reviews": {
      "type": "object",
      "properties": {
        "restaurantName": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "cuisine": {
          "type": "string"
        },
        "priceRange": {
          "type": "string",
          "enum": [
            "$",
            "$$",
            "$$$",
            "$$$$"
          ]
        },
        "visitDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "reviewer": {
          "type": "string",
          "enum": [
            "nick",
            "xavier"
          ]
        },
        "rating": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "dishesOrdered": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "price": {
                "type": "string"
              },
              "recommended": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "pros": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verdict": {
          "type": "string"
        },
        "heroImage": {
          "type": "string"
        },
        "heroImageAlt": {
          "type": "string"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "alt"
            ],
            "additionalProperties": false
          }
        },
        "paid": {
          "type": "boolean"
        },
        "comped": {
          "type": "boolean",
          "default": false
        },
        "sponsored": {
          "type": "boolean",
          "default": false
        },
        "disclosureNote": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updatedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "restaurantName",
        "city",
        "state",
        "address",
        "cuisine",
        "priceRange",
        "visitDate",
        "reviewer",
        "rating",
        "dishesOrdered",
        "pros",
        "cons",
        "verdict",
        "heroImage",
        "heroImageAlt",
        "paid",
        "description",
        "keywords",
        "publishedDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}