{
  "$ref": "#/definitions/recipes",
  "definitions": {
    "recipes": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "enum": [
            "nick",
            "xavier"
          ]
        },
        "coAuthors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "nick",
              "xavier"
            ]
          }
        },
        "heroImage": {
          "type": "string"
        },
        "heroImageAlt": {
          "type": "string"
        },
        "pinImage": {
          "type": "string"
        },
        "pinImageAlt": {
          "type": "string"
        },
        "prepTime": {
          "type": "number"
        },
        "cookTime": {
          "type": "number"
        },
        "totalTime": {
          "type": "number"
        },
        "restTime": {
          "type": "number"
        },
        "servings": {
          "type": "number"
        },
        "servingsUnit": {
          "type": "string",
          "default": "servings"
        },
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "item"
            ],
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instruction": {
                "type": "string"
              },
              "tip": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            },
            "required": [
              "instruction"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string"
        },
        "testingNotes": {
          "type": "string"
        },
        "chefTip": {
          "type": "string"
        },
        "nutrition": {
          "type": "object",
          "properties": {
            "servingSize": {
              "type": "string"
            },
            "calories": {
              "type": "number"
            },
            "fat": {
              "type": "string"
            },
            "saturatedFat": {
              "type": "string"
            },
            "carbohydrates": {
              "type": "string"
            },
            "fiber": {
              "type": "string"
            },
            "sugar": {
              "type": "string"
            },
            "protein": {
              "type": "string"
            },
            "sodium": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "videoUrl": {
          "type": "string",
          "format": "uri"
        },
        "videoType": {
          "type": "string",
          "enum": [
            "youtube",
            "tiktok",
            "instagram"
          ]
        },
        "category": {
          "type": "string"
        },
        "cuisine": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "challenging"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updatedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "author",
        "heroImage",
        "heroImageAlt",
        "prepTime",
        "cookTime",
        "servings",
        "ingredients",
        "steps",
        "category",
        "cuisine",
        "difficulty",
        "keywords",
        "publishedDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}